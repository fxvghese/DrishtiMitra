# ==========================================
# DrishtiMitra - Frontend Configuration
# ==========================================
# The frontend uses localStorage for configuration.
# No .env file is needed for the frontend.
# Configuration is done via the Settings page in the UI or by setting localStorage keys.

# ==========================================
# Required localStorage Keys (set via Settings page or manually):
# ==========================================
# dm_api_base_url       - Backend API base URL (e.g., http://localhost:8000 or https://api.example.com)
# dm_supabase_url       - Supabase project URL (for auth)
# dm_supabase_anon_key  - Supabase anon/publishable key (public, safe for client)

# ==========================================
# Example values for local development:
# ==========================================
# dm_api_base_url       = "http://localhost:8000"
# dm_supabase_url       = "https://your-project.supabase.co"
# dm_supabase_anon_key  = "your-anon-key-from-supabase-dashboard"