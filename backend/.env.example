# ==========================================
# DrishtiMitra-BaaS - Backend Environment Variables
# ==========================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control.

# ==========================================
# Application Settings
# ==========================================
APP_NAME="Legal Metrology Compliance API"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# ==========================================
# Supabase Configuration
# ==========================================
# Anon/Publishable key — used for client-facing Supabase SDK calls
# Get from: Supabase Dashboard → Project Settings → API → anon/public key
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-or-publishable-key"

# Service Role key — used for server-side admin operations (storage uploads, bucket management)
# Get from: Supabase Dashboard → Project Settings → API → service_role key
# NEVER expose this key to the frontend
SUPABASE_SERVICE_KEY="your-service-role-key-here"

# ==========================================
# Database Connection (Supabase Connection Pooler)
# ==========================================
# Session mode (port 5432): best for long-lived SQLAlchemy connections
# Get password from: Supabase Dashboard → Project Settings → Database → Database Password
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres"

# ==========================================
# JWT / Authentication
# ==========================================
# JWT secret for token verification (used by backend to validate Supabase JWTs)
# Get from: Supabase Dashboard → Project Settings → API → JWT Secret
# Alternatively, use the Supabase JWT secret from the project settings
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# ==========================================
# Optional: External Services
# ==========================================
# If you have any external API keys, add them here
# e.g., OCR_SERVICE_API_KEY="your-ocr-api-key"

# ==========================================
# Development Overrides (optional)
# ==========================================
# For local development without Supabase, you can use SQLite:
# DATABASE_URL="sqlite:///./legal_metrology.db"
# SUPABASE_URL=""
# SUPABASE_KEY=""
# SUPABASE_SERVICE_KEY=""